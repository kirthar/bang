    <string name="char_desc_bart_cassidy">Cada vez que pierde un punto de vida, roba 1 carta del mazo.</string>
    <string name="char_desc_black_jack">Al robar, enseña la 2ª carta: si es Corazones o Diamantes, roba una más.</string>
    <string name="char_desc_calamity_janet">Puede jugar sus BANG! como ¡Fallaste! y viceversa.</string>
    <string name="char_desc_el_gringo">Cuando un jugador le hace perder vida, le roba 1 carta de la mano.</string>
    <string name="char_desc_jesse_jones">Puede robar su 1ª carta de la mano de otro jugador.</string>
    <string name="char_desc_jourdonnais">Se considera que siempre tiene un Barril en juego.</string>
    <string name="char_desc_kit_carlson">Al robar, mira las 3 primeras cartas y se queda 2.</string>
    <string name="char_desc_lucky_duke">En cada «¡desenfunda!» voltea 2 cartas y elige una.</string>
    <string name="char_desc_paul_regret">Los demás lo ven a distancia +1.</string>
    <string name="char_desc_pedro_ramirez">Puede robar su 1ª carta de la pila de descartes.</string>
    <string name="char_desc_rose_doolan">Ve a los demás a distancia -1.</string>
    <string name="char_desc_sid_ketchum">Puede descartar 2 cartas para recuperar 1 vida.</string>
    <string name="char_desc_slab_the_killer">Hacen falta 2 ¡Fallaste! para cancelar sus BANG!.</string>
    <string name="char_desc_suzy_lafayette">Si se queda sin cartas en la mano, roba 1 del mazo.</string>
    <string name="char_desc_vulture_sam">Cuando un personaje es eliminado, toma todas sus cartas.</string>
    <string name="char_desc_willy_the_kid">Puede jugar tantos BANG! como quiera en su turno.</string>
