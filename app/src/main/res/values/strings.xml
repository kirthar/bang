    <string name="card_desc_bang">Dispara a un jugador a distancia igual o menor que tu alcance. Se cancela con ¡Fallaste!</string>
    <string name="card_desc_missed">Cancela un BANG! dirigido a ti. Solo como reacción.</string>
    <string name="card_desc_beer">Recupera 1 vida. Sin efecto si solo quedan 2 jugadores vivos.</string>
    <string name="card_desc_panic">Roba una carta a un jugador a distancia 1.</string>
    <string name="card_desc_cat_balou">Obliga a un jugador a descartar una carta. Sin límite de distancia.</string>
    <string name="card_desc_stagecoach">Roba 2 cartas del mazo.</string>
    <string name="card_desc_wells_fargo">Roba 3 cartas del mazo.</string>
    <string name="card_desc_gatling">Un disparo BANG! contra todos los demás jugadores.</string>
    <string name="card_desc_indians">Todos los demás descartan un BANG! o pierden 1 vida.</string>
    <string name="card_desc_duel">Reta a un jugador: alternáis descartando BANG! hasta que uno no pueda y pierda 1 vida.</string>
    <string name="card_desc_general_store">Se revelan tantas cartas como jugadores vivos; cada uno escoge una.</string>
    <string name="card_desc_saloon">Todos los jugadores vivos recuperan 1 vida.</string>
    <string name="card_desc_jail">Se juega delante de otro jugador (no el Sheriff): con Corazones escapa, si no pierde el turno.</string>
    <string name="card_desc_dynamite">Circula entre jugadores. Picas 2-9 al «¡desenfunda!»: explota y pierde 3 vidas.</string>
    <string name="card_desc_barrel">Al recibir un BANG!, «¡desenfunda!»: con Corazones cuenta como un ¡Fallaste!.</string>
    <string name="card_desc_mustang">Los demás jugadores te ven a distancia +1.</string>
    <string name="card_desc_scope">Ves a los demás jugadores a distancia -1.</string>
    <string name="card_desc_volcanic">Arma de alcance 1. BANG! ilimitados en tu turno.</string>
    <string name="card_desc_schofield">Arma de alcance 2.</string>
    <string name="card_desc_remington">Arma de alcance 3.</string>
    <string name="card_desc_rev_carabine">Arma de alcance 4.</string>
    <string name="card_desc_winchester">Arma de alcance 5.</string>

